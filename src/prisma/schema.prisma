// Prisma schema for FESTORA Event Management Platform
// Compatible with Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & RBAC ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  checkIns      CheckIn[]
  auditLogs     AuditLog[]
  assignedSpocs Spoc[]    @relation("SpocUser")

  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SUPER_ADMIN, EVENT_MANAGER, etc.
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "registrations:read", "tickets:write"
  description String?
  module      String   // registrations, tickets, speakers, etc.
  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  scope     String?  // optional scope e.g. specific category
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ==================== EVENT CONFIG ====================

model Event {
  id              String   @id @default(cuid())
  name            String   // FESTORA
  tagline         String?
  description     String?  @db.Text
  category        String?  // Food Festival, Shopping Exhibition & Carnival
  logoUrl         String?
  bannerUrl       String?
  theme           String?
  startDate       DateTime
  endDate         DateTime
  startTime       String?  // "10:00"
  endTime         String?  // "22:00"
  timezone        String   @default("Asia/Kolkata")
  venueName       String?
  venueAddress    String?
  googleMapsUrl   String?
  organizerName   String?
  organizerEmail  String?
  organizerPhone  String?
  websiteUrl      String?
  socialLinks     Json?    // { instagram, facebook, twitter, etc. }
  isPublished     Boolean  @default(false)
  registrationMode String  @default("OPEN") // OPEN | RSVP | INVITATION_ONLY
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings        EventSetting[]
  pages           EventPage[]
  ticketTypes     TicketType[]
  registrations   Registration[]
  speakers        Speaker[]
  sponsors        Sponsor[]
  exhibitors      Exhibitor[]
  stalls          Stall[]
  artists         Artist[]
  performers      Performer[]
  volunteers      Volunteer[]
  spocs           Spoc[]
  formFields      RegistrationFormField[]
  emailTemplates  EmailTemplate[]
  campaigns       EmailCampaign[]
  reminders       Reminder[]
  invitations     Invitation[]
  mediaAssets     MediaAsset[]
}

model EventSetting {
  id        String   @id @default(cuid())
  eventId   String
  key       String
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
}

model EventPage {
  id          String   @id @default(cuid())
  eventId     String
  slug        String   // home, about, agenda, speakers, etc.
  title       String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  content     Json?    // flexible content blocks
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slug])
}

// ==================== TICKETING & REGISTRATION ====================

model TicketType {
  id              String   @id @default(cuid())
  eventId         String
  name            String   // General, VIP, Stall Owner, Speaker, etc.
  description     String?
  price           Decimal  @default(0) @db.Decimal(10, 2)
  currency        String   @default("INR")
  capacity        Int?
  soldCount       Int      @default(0)
  isActive        Boolean  @default(true)
  requiresApproval Boolean @default(false)
  formConfig      Json?    // custom form fields for this type
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  tickets       Ticket[]
  spocAssignments SpocAssignment[]
  formFields    RegistrationFormField[]

  @@index([eventId])
}

model RegistrationFormField {
  id           String   @id @default(cuid())
  eventId      String
  ticketTypeId String?  // null = global form
  label        String
  fieldKey     String
  fieldType    String   // text, email, phone, select, radio, checkbox, file, textarea
  options      Json?    // for select/radio/checkbox
  isRequired   Boolean  @default(false)
  placeholder  String?
  sortOrder    Int      @default(0)
  validation   Json?
  conditional  Json?    // show if other field equals value
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([ticketTypeId])
}

model Registration {
  id              String   @id @default(cuid())
  eventId         String
  ticketTypeId    String
  registrationId  String   @unique // human readable e.g. FES-2027-0001
  status          String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, REJECTED
  fullName        String
  email           String
  phone           String?
  organization    String?
  designation     String?
  city            String?
  country         String?
  rsvpStatus      String?  // ATTENDING, NOT_ATTENDING, MAYBE
  invitationCode  String?
  answers         Json?    // dynamic form answers
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    Ticket[]
  answersRel RegistrationAnswer[]

  @@unique([eventId, email, ticketTypeId])
  @@index([eventId])
  @@index([status])
  @@index([email])
}

model RegistrationAnswer {
  id             String @id @default(cuid())
  registrationId String
  fieldKey       String
  value          String @db.Text

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model Ticket {
  id              String   @id @default(cuid())
  registrationId  String
  ticketTypeId    String
  ticketNumber    String   @unique // e.g. TKT-FES-2027-0001
  qrToken         String   @unique // secure random token for QR
  status          String   @default("VALID") // VALID, USED, CANCELLED, EXPIRED
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?
  metadata        Json?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  checkIns     CheckIn[]
  verifications TicketVerification[]

  @@index([qrToken])
  @@index([ticketNumber])
  @@index([status])
}

model TicketVerification {
  id        String   @id @default(cuid())
  ticketId  String
  result    String   // VALID, ALREADY_USED, CANCELLED, INVALID, EXPIRED
  scannedBy String?
  scannedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  notes     String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model CheckIn {
  id          String   @id @default(cuid())
  ticketId    String
  checkedInBy String?  // userId of staff
  checkedInAt DateTime @default(now())
  location    String?
  notes       String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff  User?  @relation(fields: [checkedInBy], references: [id])

  @@index([ticketId])
  @@index([checkedInAt])
}

// ==================== PEOPLE & ENTITIES ====================

model Speaker {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  title       String?
  bio         String?  @db.Text
  photoUrl    String?
  email       String?
  phone       String?
  company     String?
  socialLinks Json?
  sessions    Json?    // array of session objects
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Sponsor {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  tier        String?  // Gold, Silver, etc.
  logoUrl     String?
  websiteUrl  String?
  description String?  @db.Text
  contactName String?
  contactEmail String?
  contactPhone String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Exhibitor {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?  @db.Text
  logoUrl     String?
  boothNumber String?
  category    String?
  contactName String?
  contactEmail String?
  contactPhone String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Stall {
  id            String   @id @default(cuid())
  eventId       String
  stallNumber   String
  name          String
  category      String?  // Food, Shopping, etc.
  description   String?  @db.Text
  ownerName     String?
  ownerEmail    String?
  ownerPhone    String?
  location      String?
  isFoodStall   Boolean  @default(false)
  status        String   @default("AVAILABLE") // AVAILABLE, ALLOCATED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, stallNumber])
  @@index([eventId])
}

model Artist {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  bio         String?  @db.Text
  photoUrl    String?
  genre       String?
  email       String?
  phone       String?
  socialLinks Json?
  schedule    Json?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Performer {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  type        String?  // Dance, Music, Comedy, etc.
  bio         String?  @db.Text
  photoUrl    String?
  email       String?
  phone       String?
  schedule    Json?
  stage       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Volunteer {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  email       String?
  phone       String?
  role        String?
  shift       String?
  notes       String?  @db.Text
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ==================== SPOC SYSTEM ====================

model Spoc {
  id              String   @id @default(cuid())
  eventId         String
  userId          String?  // linked system user if any
  name            String
  designation     String?
  department      String?
  email           String
  phone           String?
  whatsapp        String?
  photoUrl        String?
  responsibility  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?            @relation("SpocUser", fields: [userId], references: [id])
  assignments SpocAssignment[]

  @@index([eventId])
}

model SpocAssignment {
  id           String @id @default(cuid())
  spocId       String
  ticketTypeId String
  isPrimary    Boolean @default(true)

  spoc       Spoc       @relation(fields: [spocId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([spocId, ticketTypeId])
}

// ==================== EMAIL & REMINDERS ====================

model EmailTemplate {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  subject   String
  bodyHtml  String   @db.Text
  bodyText  String?  @db.Text
  type      String   // confirmation, reminder, campaign, etc.
  variables Json?    // list of supported variables
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EmailCampaign {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  subject     String
  bodyHtml    String    @db.Text
  status      String    @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, FAILED
  scheduledAt DateTime?
  sentAt      DateTime?
  recipientFilter Json? // ticket types, statuses, custom
  totalRecipients Int   @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipients EmailRecipient[]
  logs       EmailLog[]

  @@index([eventId])
  @@index([status])
}

model EmailRecipient {
  id         String   @id @default(cuid())
  campaignId String
  email      String
  name       String?
  status     String   @default("PENDING") // PENDING, SENT, FAILED, BOUNCED
  sentAt     DateTime?
  error      String?
  metadata   Json?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
}

model EmailLog {
  id         String   @id @default(cuid())
  campaignId String?
  toEmail    String
  subject    String
  status     String   // SENT, FAILED, BOUNCED, DELIVERED
  providerId String?  // Resend message id
  error      String?
  sentAt     DateTime @default(now())
  metadata   Json?

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id])

  @@index([toEmail])
  @@index([sentAt])
}

model Reminder {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  subject     String
  bodyHtml    String    @db.Text
  scheduledAt DateTime
  status      String    @default("SCHEDULED") // SCHEDULED, SENT, CANCELLED, FAILED
  sentAt      DateTime?
  recipientFilter Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipients ReminderRecipient[]

  @@index([eventId])
  @@index([scheduledAt])
  @@index([status])
}

model ReminderRecipient {
  id         String   @id @default(cuid())
  reminderId String
  email      String
  name       String?
  status     String   @default("PENDING")
  sentAt     DateTime?
  error      String?

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
}

// ==================== INVITATIONS (Mode C) ====================

model Invitation {
  id          String    @id @default(cuid())
  eventId     String
  code        String    @unique
  email       String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  status      String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([code])
}

// ==================== MEDIA & AUDIT ====================

model MediaAsset {
  id        String   @id @default(cuid())
  eventId   String
  filename  String
  url       String
  mimeType  String?
  size      Int?
  altText   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // CREATE, UPDATE, DELETE, LOGIN, CHECKIN, etc.
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
